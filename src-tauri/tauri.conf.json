{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SJMR Cheque Writer",
  "version": "2.3.0",
  "identifier": "com.sonyrpm.sjmrchequewriter",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SJMR Cheque Writer",
        "width": 1120,
        "height": 740,
        "minWidth": 920,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#f3efe6",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "SJMR Software",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
